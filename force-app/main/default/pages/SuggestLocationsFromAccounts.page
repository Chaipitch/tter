<apex:page standardController="Account" recordSetVar="accounts"
           extensions="SuggestLocationsFromAccountsController"
           lightningStylesheets="true" title="Suggest Locations (Google)">
    <apex:slds />
    <style>
        /* Modal look: centered floating card on a grey backdrop */
        html, body { background: transparent; }
        .geo-modal .slds-modal__container { width: 90%; max-width: 42rem; min-width: 20rem; }
        .geo-modal .slds-modal__content { min-height: 8rem; }
        .geo-summary td:last-child { text-align: right; white-space: nowrap; }
    </style>
    <script>
        // Lightning Experience: StandardSetController.cancel() returns a Salesforce Classic URL, which shows
        // "The page no longer exists". Go back to the Account list view the Lightning way instead.
        // Returns true when handled (the button then doesn't submit); false in Salesforce Classic.
        function geoBackToList() {
            if (typeof sforce === 'undefined' || !sforce.one) {
                return false;
            }
            if (sforce.one.back) {
                sforce.one.back(true);   // previous page = the list view, refreshed
            } else {
                sforce.one.navigateToURL('/lightning/o/Account/list');
            }
            return true;
        }
    </script>

    <div class="slds-scope">
        <apex:form >
            <apex:outputPanel id="modal" layout="block">
                <apex:actionPoller action="{!refreshStatus}" interval="5" reRender="modal" enabled="{!polling}" />

                <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="geo-modal-title"
                         class="slds-modal slds-fade-in-open geo-modal">
                    <div class="slds-modal__container">

                        <!-- header -->
                        <div class="slds-modal__header">
                            <apex:commandLink action="{!back}" immediate="true" title="Close"
                                              onclick="if (geoBackToList()) { return false; }"
                                              styleClass="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse">
                                <span style="font-size: 1.5rem; line-height: 1;">&#215;</span>
                                <span class="slds-assistive-text">Close</span>
                            </apex:commandLink>
                            <h1 id="geo-modal-title" class="slds-modal__title slds-hyphenate">Suggest Locations (Google)</h1>
                        </div>

                        <!-- content -->
                        <div class="slds-modal__content slds-p-around_medium">
                            <apex:pageMessages />

                            <!-- before Start -->
                            <apex:outputPanel layout="block" rendered="{!NOT(started)}">
                                <apex:outputPanel rendered="{!NOT(enabled)}">
                                    <p class="slds-m-bottom_small">
                                        Location lookup is turned off. Ask your administrator to enable
                                        <b>Google Maps Settings</b> (and add an API key, or set Provider to OpenStreetMap).
                                    </p>
                                </apex:outputPanel>

                                <apex:outputPanel rendered="{!enabled}">
                                    <p class="slds-text-heading_small slds-m-bottom_small">
                                        <b><apex:outputText value="{!unprocessedCount}" /><apex:outputText value="+" rendered="{!moreThanCounted}" /></b>
                                        oggLocation record(s) not processed yet
                                    </p>
                                    <p class="slds-m-bottom_small">
                                        <b>Start</b> looks up all of them (isCoordsUpdated unchecked). Which Accounts are
                                        selected doesn't matter.
                                    </p>
                                    <p class="slds-m-bottom_small slds-text-color_weak">
                                        It runs in the background in batches; large volumes can take a while. To process a
                                        record again, untick its isCoordsUpdated or use the "Suggest Location (Google)"
                                        button on the record.
                                    </p>
                                    <apex:outputPanel rendered="{!openStreetMap}">
                                        <p class="slds-m-bottom_small slds-text-color_error">
                                            Provider is OpenStreetMap (temporary, testing only): at most
                                            {!openStreetMapLimit} records are processed per run.
                                        </p>
                                    </apex:outputPanel>
                                </apex:outputPanel>
                            </apex:outputPanel>

                            <!-- after Start: progress -->
                            <apex:outputPanel layout="block" rendered="{!started}">
                                <p class="slds-m-bottom_x-small">
                                    <b><apex:outputText value="{!IF(finished, 'Finished', 'Running')}" /></b>
                                    <span class="slds-text-color_weak">&#160;&#183;&#160;status: {!jobStatus}</span>
                                </p>
                                <div class="slds-progress-bar slds-progress-bar_large slds-m-bottom_x-small"
                                     role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{!percent}">
                                    <span class="slds-progress-bar__value {!IF(AND(finished, batchesFailed == 0), 'slds-progress-bar__value_success', '')}"
                                          style="width: {!percent}%;"></span>
                                </div>
                                <p class="slds-m-bottom_medium slds-text-color_weak">
                                    {!percent}% &#183;
                                    <apex:outputText rendered="{!batchesTotal > 0}"
                                        value="batch {!batchesProcessed} of {!batchesTotal}, about {!recordsDoneApprox} of {!recordsInRun} record(s)" />
                                    <apex:outputText rendered="{!AND(batchesTotal == 0, NOT(finished))}"
                                        value="waiting to start (other background jobs may be running)" />
                                    <apex:outputText rendered="{!NOT(finished)}"
                                        value=" · updates every 5 seconds; you can close this, the run continues in the background" />
                                </p>

                                <!-- summary -->
                                <apex:outputPanel layout="block" rendered="{!finished}">
                                    <h2 class="slds-text-heading_small slds-m-bottom_x-small">Summary</h2>
                                    <table class="slds-table slds-table_bordered slds-table_cell-buffer slds-m-bottom_small geo-summary">
                                        <tbody>
                                            <tr><td>Updated with a suggested location</td>
                                                <td><b>{!updatedCount}</b></td></tr>
                                            <tr><td>&#160;&#160;&#8230; more than {!farDistanceMeters} m from UPWARD's pin (worth checking)</td>
                                                <td>{!farCount}</td></tr>
                                            <tr><td>&#160;&#160;&#8230; without a distance (UPWARD's pin empty or invalid)</td>
                                                <td>{!noDistanceCount}</td></tr>
                                            <tr><td>Still not processed (blank or unfindable address, or the lookup failed; retried next run)</td>
                                                <td>{!remainingCount}</td></tr>
                                            <tr><td>Batches failed (see Setup &gt; Apex Jobs)</td>
                                                <td>{!batchesFailed}</td></tr>
                                        </tbody>
                                    </table>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(jobMessage))}">
                                        <p class="slds-text-color_error slds-m-bottom_small">{!jobMessage}</p>
                                    </apex:outputPanel>
                                    <p class="slds-text-body_small slds-text-color_weak">
                                        Counted from the data: oggLocations flagged since this run started (records the
                                        on-create trigger processed at the same time are included) and those still unflagged.
                                    </p>
                                    <!-- Lightning toast when the run has finished (only in Lightning Experience, once per run) -->
                                    <script>
                                        (function () {
                                            var key = 'geoToast_{!jobId}';
                                            if (window[key] || typeof sforce === 'undefined' || !sforce.one || !sforce.one.showToast) {
                                                return;
                                            }
                                            window[key] = true;
                                            sforce.one.showToast({
                                                title: 'Location lookup finished',
                                                message: '{!updatedCount} updated ({!farCount} more than {!farDistanceMeters} m from UPWARD\'s pin), '
                                                    + '{!remainingCount} still not processed'
                                                    + ({!batchesFailed} > 0 ? ', {!batchesFailed} batch(es) failed' : '') + '.',
                                                type: {!batchesFailed} > 0 ? 'warning' : 'success'
                                            });
                                        })();
                                    </script>
                                </apex:outputPanel>
                            </apex:outputPanel>
                        </div>

                        <!-- footer -->
                        <div class="slds-modal__footer">
                            <apex:outputPanel rendered="{!NOT(started)}">
                                <apex:commandButton action="{!back}" value="Cancel" immediate="true"
                                                    onclick="if (geoBackToList()) { return false; }"
                                                    styleClass="slds-button slds-button_neutral" />
                                <apex:commandButton action="{!start}" value="Start"
                                                    disabled="{!NOT(enabled) || unprocessedCount == 0}"
                                                    styleClass="slds-button slds-button_brand" />
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!started}">
                                <apex:commandButton action="{!back}" value="{!IF(finished, 'Back to list', 'Close')}" immediate="true"
                                                    onclick="if (geoBackToList()) { return false; }"
                                                    styleClass="slds-button {!IF(finished, 'slds-button_brand', 'slds-button_neutral')}" />
                            </apex:outputPanel>
                        </div>
                    </div>
                </section>
                <div class="slds-backdrop slds-backdrop_open" role="presentation"></div>
            </apex:outputPanel>
        </apex:form>
    </div>
</apex:page>
