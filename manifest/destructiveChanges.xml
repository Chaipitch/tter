<?xml version="1.0" encoding="UTF-8"?>
<!--
  Removes the old automatic trigger and its handler from an org where they were deployed before
  (tterakit-sb). Pass this file to the deploy with the post-destructive-changes flag; see docs/DEPLOYMENT_GUIDE.md.
  Orgs that never had the trigger don't need it.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>AccountLocationTriggerHandler</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>AccountLocationTrigger</members>
        <name>ApexTrigger</name>
    </types>
    <version>62.0</version>
</Package>
